# Environment variables
.env

# Node.js
/bin/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
dist/
build/

# Pulumi
Pulumi.*.yaml.bak
# `pulumi deployment settings pull` writes this. Do NOT commit it: the
# deployment settings are declared in src/pulumi-cloud/deployment-settings.ts
# and a committed copy is a second source of truth that drifts silently.
# It is also written in the legacy shape, so the copy is wrong the moment
# it lands. The trigger `paths` it carries are a security control.
Pulumi.*.deploy.yaml

