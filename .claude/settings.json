{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "pulumi-agent-skills": {
      "source": {
        "source": "github",
        "repo": "pulumi/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "pulumi@pulumi-agent-skills": true
  }
}
