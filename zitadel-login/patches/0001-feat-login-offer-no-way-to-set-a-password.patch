+++ b/apps/login/src/lib/password-setup.ts
@@ -0,0 +1,10 @@
+// Liverty Music: the hosted login sets no password. Fans and members sign in
+// with passkeys (or an identity provider); only identities that already have a
+// password may still sign in with it (`sendPassword`). A Server Action stays a
+// callable endpoint even when no page uses it, so every action that would set
+// a password returns this error without calling the Zitadel API.
+export const PASSWORD_SETUP_REFUSED = "Setting a password is not available.";
+
+// The refused actions keep the shape of their upstream result (an error, or an
+// API response) so their callers type-check unchanged.
+export type PasswordSetupResult = { error: string } | { details?: unknown };
