+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { PASSWORD_SETUP_REFUSED } from "../password-setup";
+import { registerUser } from "./register";
+
+// Liverty Music: sign-up creates no password (see lib/password-setup.ts).
+
+vi.mock("next/headers", () => ({
+  headers: vi.fn(),
+}));
+
+vi.mock("next-intl/server", () => ({
+  getTranslations: vi.fn(() => (key: string) => key),
+}));
+
+vi.mock("@zitadel/client", () => ({
+  create: vi.fn(),
+  Code: { NotFound: 5 },
+  ConnectError: class extends Error {},
+}));
+
+vi.mock("../service-url", () => ({
+  getServiceConfig: vi.fn(),
+}));
+
+vi.mock("@/lib/zitadel", () => ({
+  addHumanUser: vi.fn(),
+  addIDPLink: vi.fn(),
+  getLoginSettings: vi.fn(),
+  getUserByID: vi.fn(),
+  listAuthenticationMethodTypes: vi.fn(),
+}));
+
+vi.mock("@/lib/server/cookie", () => ({
+  createSessionAndUpdateCookie: vi.fn(),
+  createSessionForIdpAndUpdateCookie: vi.fn(),
+}));
+
+vi.mock("../client", () => ({
+  completeFlowOrGetUrl: vi.fn(),
+}));
+
+vi.mock("../verification-check", () => ({
+  setUserVerificationCheckCookie: vi.fn(),
+}));
+
+vi.mock("../verify-helper", () => ({
+  checkEmailVerification: vi.fn(),
+  checkMFAFactors: vi.fn(),
+}));
+
+describe("registerUser", () => {
+  let zitadel: any;
+  let cookie: any;
+
+  beforeEach(async () => {
+    vi.clearAllMocks();
+    const { headers } = await import("next/headers");
+    const { getServiceConfig } = await import("../service-url");
+    vi.mocked(headers).mockResolvedValue({} as any);
+    vi.mocked(getServiceConfig).mockReturnValue({ serviceConfig: { baseUrl: "https://api.example.com" } } as any);
+    zitadel = await import("@/lib/zitadel");
+    cookie = await import("@/lib/server/cookie");
+    zitadel.getLoginSettings.mockResolvedValue({ allowRegister: true, allowLocalAuthentication: true });
+  });
+
+  test("refuses a password without creating the user", async () => {
+    const result = await registerUser({
+      email: "fan@example.com",
+      firstName: "Fan",
+      lastName: "Example",
+      password: "N3w-password!",
+      organization: "org123",
+    });
+
+    expect(result).toEqual({ error: PASSWORD_SETUP_REFUSED });
+    expect(zitadel.getLoginSettings).not.toHaveBeenCalled();
+    expect(zitadel.addHumanUser).not.toHaveBeenCalled();
+    expect(cookie.createSessionAndUpdateCookie).not.toHaveBeenCalled();
+  });
+
+  test("still creates a user without a password, for passkey registration", async () => {
+    zitadel.addHumanUser.mockResolvedValue(null);
+
+    await registerUser({
+      email: "fan@example.com",
+      firstName: "Fan",
+      lastName: "Example",
+      organization: "org123",
+    });
+
+    expect(zitadel.addHumanUser).toHaveBeenCalledWith(expect.objectContaining({ password: undefined }));
+  });
+});
