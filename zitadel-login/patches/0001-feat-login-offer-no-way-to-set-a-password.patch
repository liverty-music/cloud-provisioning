@@ -0,0 +1,46 @@
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { PASSWORD_SETUP_REFUSED } from "./password-setup";
+import { setMyPassword } from "./self";
+
+// Liverty Music: the hosted login sets no password (see lib/password-setup.ts).
+
+vi.mock("next/headers", () => ({
+  headers: vi.fn(),
+}));
+
+vi.mock("@zitadel/client/v2", () => ({
+  createUserServiceClient: vi.fn(),
+}));
+
+vi.mock("./service-url", () => ({
+  getServiceConfig: vi.fn(),
+}));
+
+vi.mock("./cookies", () => ({
+  getSessionCookieById: vi.fn(),
+}));
+
+vi.mock("./zitadel", () => ({
+  createServerTransport: vi.fn(),
+  getSession: vi.fn(),
+}));
+
+describe("setMyPassword", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  test("refuses without reading the session or calling the user service", async () => {
+    const { getSessionCookieById } = await import("./cookies");
+    const { getSession, createServerTransport } = await import("./zitadel");
+    const { createUserServiceClient } = await import("@zitadel/client/v2");
+
+    const result = await setMyPassword({ sessionId: "session123", password: "N3w-password!" });
+
+    expect(result).toEqual({ error: PASSWORD_SETUP_REFUSED });
+    expect(getSessionCookieById).not.toHaveBeenCalled();
+    expect(getSession).not.toHaveBeenCalled();
+    expect(createServerTransport).not.toHaveBeenCalled();
+    expect(createUserServiceClient).not.toHaveBeenCalled();
+  });
+});
