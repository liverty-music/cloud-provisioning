new file mode 100644
index 0000000..ea8978b
--- /dev/null
+++ b/apps/login/src/lib/server/password-setup.ts
@@ -0,0 +1,9 @@
+import "server-only";
+
+// Liverty Music: the hosted login sets no password. Fans and members sign in
+// with passkeys (or an identity provider); only identities that already have a
+// password may still sign in with it (`sendPassword`). Every Server Action in
+// src/lib/actions/ is a public endpoint whether or not a page uses it, so each
+// action that would set a password returns this error without calling the
+// Zitadel API.
+export const PASSWORD_SETUP_REFUSED = "Setting a password is not available.";
