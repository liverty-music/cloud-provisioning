# Environment
ENVIRONMENT=development
# CORS — consumer API. The admin console now calls api.admin (its own CORS),
# so the admin origin is no longer needed here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000,https://dev.liverty-music.app
# CORS — admin API (admin origins only), governed independently of the consumer API.
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000,https://admin.dev.liverty-music.app
# CORS — organizer API (organizer origins only), governed independently of the consumer/admin APIs.
ORGANIZER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000,https://organizer.dev.liverty-music.app
# CORS — reception API (rpc.scanner.v1.ScannerService; the reception web origin only).
RECEPTION_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://reception.dev.liverty-music.app
# GCP
GCP_PROJECT_ID=liverty-music-dev
# GCP_VERTEX_AI_SEARCH_DATA_STORE=projects/liverty-music-dev/locations/global/collections/default_collection/dataStores/concert-search-engine
# Database
DATABASE_USER=fan-api@liverty-music-dev.iam
# Official hashed .sql.goog domain is required for Go SDK/Cloud SQL Connector TLS verification.
DATABASE_HOST=6ea7e9f2efe1.3saucev2x125n.asia-northeast2.sql.goog.
DATABASE_INSTANCE_CONNECTION_NAME=liverty-music-dev:asia-northeast2:postgres-osaka
# Connection pool: one share of the db-f1-micro budget (max_connections 25,
# shared with Zitadel). The pools of every workload, Zitadel included, add up
# to 22 (OpenSpec change introduce-durable-workflows, design "Connections").
DATABASE_MAX_OPEN_CONNS=3
DATABASE_MAX_IDLE_CONNS=1
# OIDC
OIDC_ISSUER_URL=https://auth.dev.liverty-music.app
# The fan app's Zitadel client id, the same value as `zitadelClientId` in the
# fan web ConfigMap (frontend overlay). It is the audience of the ID token that
# proves a fan's fresh sign-in before the fan deletes their account. Required
# on the fan workload (OpenSpec change delete-fan-accounts, design D3).
FAN_OIDC_CLIENT_ID=371355407710421859
# Zitadel product org id. dev is stopped, so `pulumi stack output productOrgId`
# returns the shutdown sentinel; this is the last known dev id (fan-web config
# `zitadelOrgId`). Re-check it when dev is restarted.
ZITADEL_PRODUCT_ORG_ID=371348346264093539

# NATS
NATS_URL=nats://nats.nats.svc.cluster.local:4222
# Telemetry
TELEMETRY_OTLP_ENDPOINT=otel-collector.otel-collector.svc.cluster.local:4318

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=BNg-zJP4IiX11Cz1dghWll0mwBnMV6oeOSSVsYyOK2l8NFAqN9xHFSTS_W3_oXO4k3BlMyYLjkMUE-uA7LABGHo
# Object storage, provisioned by Pulumi ObjectStorageComponent (`pulumi stack
# output storageBucketName` / `cdnBaseUrl`). Dev is intentionally stopped
# (workloadEnabled=false), so these values are inert placeholders.
# STORAGE_BUCKET: served bucket. Objects are SERVED via Cloud CDN, not this
# bucket directly (the org's Domain Restricted Sharing rejects `allUsers`).
# STORAGE_INTERNAL_BUCKET: PRIVATE bucket for the originals organizers upload.
# organizer-console-api (which shares this ConfigMap via envFrom) signs direct
# uploads into it and admin-console-api removes a deleted Organizer's originals
# from it. Required on every API workload: the backend refuses to start outside
# local without it.
# CDN_BASE_URL: public Cloud CDN serving base URL (external HTTPS LB + Cloud CDN
# backend bucket). The backend composes object URLs as
# {CDN_BASE_URL}/cdn/{organizer_id}/{series_image_id}/{variant}.webp.
STORAGE_BUCKET=liverty-music-dev
STORAGE_INTERNAL_BUCKET=liverty-music-dev-internal
CDN_BASE_URL=https://cdn.dev.liverty-music.app
# Fan web origin (scheme + host) for Event page link previews: the canonical
# og:url and the default og:image. Required — fan-api refuses to start without
# it (OpenSpec change public-event-page).
FAN_WEB_BASE_URL=https://dev.liverty-music.app

# Pocket Sign identity verification (spec: identity-verification). Non-secret half of the config; the
# Bearer token is POCKET_SIGN_TOKEN, synced from GSM `pocket-sign-token` via
# ExternalSecret (added in a follow-up PR after `pulumi up` provisions it).
# MVP DECISION: every env, including prod, uses the FREE mock/sandbox host
# (verify.mock.p8n.app) — the paid 加盟契約 + prod tenant (verify.p8n.app) are
# POST-MVP. `PocketSignConfig.Validate` requires all-or-none + https + *.p8n.app.
# The tenant id is the sandbox tenant (identifier only; the token is the secret).
POCKET_SIGN_BASE_URL=https://verify.mock.p8n.app
POCKET_SIGN_TENANT_ID=e4b147b4-9bb5-4d6b-b0a5-cfec4123047e
POCKET_SIGN_CALLBACK_URL=https://dev.liverty-music.app/verify/callback

# Stripe Connect onboarding return URL: where the Stripe-hosted payout
# onboarding sends the Organizer back. The organizer console has no payout page
# yet, so this is its root. Required: the backend refuses to start outside local
# without an absolute https URL.
STRIPE_ONBOARDING_RETURN_URL=https://organizer.dev.liverty-music.app/
