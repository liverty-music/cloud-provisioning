# Environment
ENVIRONMENT=development
# GCP
GCP_PROJECT_ID=liverty-music-dev
# NATS
NATS_URL=nats://nats.nats.svc.cluster.local:4222
# Telemetry
TELEMETRY_OTLP_ENDPOINT=otel-collector.otel-collector.svc.cluster.local:4318
# Object storage buckets (ObjectStorageComponent). Names match `pulumi stack
# output` for this stack. Dev is intentionally stopped (workloadEnabled=false),
# so the buckets do not exist and these values are inert placeholders kept
# coherent with prod.
STORAGE_INTERNAL_BUCKET=liverty-music-dev-internal
STORAGE_BUCKET=liverty-music-dev
