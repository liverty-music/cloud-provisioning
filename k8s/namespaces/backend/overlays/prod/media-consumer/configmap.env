# Environment
ENVIRONMENT=production
# GCP
GCP_PROJECT_ID=liverty-music-prod
# Database — prod Cloud SQL via the in-process Go connector (IAM auth). Mirrors
# event-consumer's prod DB block but authenticates as the media-consumer IAM DB
# user (created in postgres.ts; app-schema grants via a backend grant migration).
DATABASE_USER=media-consumer@liverty-music-prod.iam
DATABASE_HOST=298474959c18.25pf3r4b6sfkn.asia-northeast2.sql.goog.
DATABASE_INSTANCE_CONNECTION_NAME=liverty-music-prod:asia-northeast2:postgres-osaka
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_IDLE_CONNS=1
# NATS
NATS_URL=nats://nats.nats.svc.cluster.local:4222
# Telemetry
TELEMETRY_OTLP_ENDPOINT=otel-collector.otel-collector.svc.cluster.local:4318
# Organizer media buckets. Names match `pulumi stack output` for this stack.
ORGANIZER_MEDIA_INTERNAL_BUCKET=liverty-music-prod-organizer-media-internal
ORGANIZER_MEDIA_BUCKET=liverty-music-prod-organizer-media
