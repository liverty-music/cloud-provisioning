# Environment
ENVIRONMENT=production
# CORS — consumer API. The admin console now calls api.admin (its own CORS),
# so the admin origin is no longer needed here.
CORS_ALLOWED_ORIGINS=https://liverty-music.app
# CORS — admin API (admin origins only), governed independently of the consumer API.
ADMIN_CORS_ALLOWED_ORIGINS=https://admin.liverty-music.app
# CORS — organizer API (organizer origins only), governed independently of the consumer/admin APIs.
ORGANIZER_CORS_ALLOWED_ORIGINS=https://organizer.liverty-music.app
# GCP
GCP_PROJECT_ID=liverty-music-prod
# Database
DATABASE_USER=fan-api@liverty-music-prod.iam
# Official hashed .sql.goog domain is required for Go SDK/Cloud SQL Connector TLS verification.
DATABASE_HOST=298474959c18.25pf3r4b6sfkn.asia-northeast2.sql.goog.
DATABASE_INSTANCE_CONNECTION_NAME=liverty-music-prod:asia-northeast2:postgres-osaka
# Connection pool: db-f1-micro budget (25 total) → 5 per workload + headroom for Atlas/ops
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_IDLE_CONNS=1
# OIDC
OIDC_ISSUER_URL=https://auth.liverty-music.app

# NATS
NATS_URL=nats://nats.nats.svc.cluster.local:4222
# Telemetry
TELEMETRY_OTLP_ENDPOINT=otel-collector.otel-collector.svc.cluster.local:4318

# Push Notifications (VAPID) — public half of the prod keypair whose private
# half lives in GSM `vapid-private-key` (project `liverty-music-prod`).
# Derived 2026-05-15 from the GSM scalar via Python `cryptography` (P-256
# SECP256R1 point multiplication, Base64URL-encoded uncompressed). See
# OpenSpec change `prepare-prod-service-in` §6 — Mode B exception case:
# GSM was already prod-specific from the original prod bootstrap, only the
# configmap public was carried over from dev as a placeholder, so the fix
# is a configmap-only update rather than a full keypair regen.
VAPID_PUBLIC_KEY=BH-m9-6-0-y70MdQG7Lz-htDaz4T_NuYdmcgK5wBEElzXo22AyGs30gvHAtHbWtQBQa4XxySD6ZEaiM9Crwl6Pc
# PRIVATE GCS bucket for organizer-authored media (cover images at MVP). The
# organizer-console-api workload (which shares this ConfigMap via envFrom)
# WRITES objects here; objects are SERVED via Cloud CDN, not this bucket
# directly (the org's Domain Restricted Sharing rejects `allUsers`).
# Bucket provisioned by Pulumi (OrganizerMediaComponent); name matches
# `pulumi stack output organizerMediaBucketName` for the prod stack.
ORGANIZER_MEDIA_BUCKET=liverty-music-prod-organizer-media
# Public Cloud CDN serving base URL for organizer media. The backend composes
# object URLs as {ORGANIZER_MEDIA_CDN_BASE}/cdn/{organizer_id}/{media_id}.
# Served via an external HTTPS LB + Cloud CDN backend bucket (Pulumi
# OrganizerMediaComponent); matches `pulumi stack output
# organizerMediaCdnBaseUrl` for the prod stack.
ORGANIZER_MEDIA_CDN_BASE=https://media.liverty-music.app

# Pocket Sign eKYC (identity-ekyc-jpki). Non-secret half of the config; the
# Bearer token is POCKET_SIGN_TOKEN, synced from GSM `pocket-sign-token` via
# ExternalSecret (added in a follow-up PR after prod `pulumi up` provisions it).
# MVP DECISION: prod intentionally points at the FREE mock/sandbox host
# (verify.mock.p8n.app) so E2E runs with no 加盟契約 — flipping to the production
# 認定PF endpoint (verify.p8n.app) is a single-line change deferred to POST-MVP.
# `PocketSignConfig.Validate` requires all-or-none + https + *.p8n.app (mock ok).
# The tenant id is the sandbox tenant (identifier only; the token is the secret).
POCKET_SIGN_BASE_URL=https://verify.mock.p8n.app
POCKET_SIGN_TENANT_ID=e4b147b4-9bb5-4d6b-b0a5-cfec4123047e
POCKET_SIGN_CALLBACK_URL=https://liverty-music.app/verify/callback
