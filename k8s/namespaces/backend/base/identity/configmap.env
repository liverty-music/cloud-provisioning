# Environment
ENVIRONMENT=TO_REPLACE_BY_OVERLAY
# Logging
LOGGING_LEVEL=info
LOGGING_FORMAT=json
# Telemetry
TELEMETRY_SERVICE_NAME=liverty-music-identity
TELEMETRY_OTLP_ENDPOINT=TO_REPLACE_BY_OVERLAY
# Listeners: 8080 health, 9100 event consumer, 9101 admin console API, 9102 fan API (defaults)
SERVER_HOST=0.0.0.0
# Shutdown timeout must fit within: terminationGracePeriodSeconds(45) - preStop(5) - buffer(10) = 30s
SHUTDOWN_TIMEOUT=30s
# Identity provider
OIDC_ISSUER_URL=TO_REPLACE_BY_OVERLAY
ORGANIZER_CONSOLE_PROJECT_ID=TO_REPLACE_BY_OVERLAY
ZITADEL_MACHINE_KEY_FOR_BACKEND_APP_PATH=/secrets/zitadel/zitadel-machine-key-for-backend-app.json
ZITADEL_MACHINE_KEY_FOR_FAN_PASSKEY_RECOVERY_PATH=/secrets/zitadel/zitadel-machine-key-for-fan-passkey-recovery.json
ZITADEL_MACHINE_KEY_FOR_ORGANIZER_PROVISIONER_PATH=/secrets/zitadel/zitadel-machine-key-for-organizer-provisioner.json

# Downgrade the protobuf global-registry extension-number collision (ext 50001 on
# google.protobuf.MethodOptions) between zitadel-go and the Pocket Sign gen protos
# from a startup PANIC to ignore (see event-consumer/configmap.env).
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore
