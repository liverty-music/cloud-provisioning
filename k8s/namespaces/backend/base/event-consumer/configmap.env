# Environment
ENVIRONMENT=TO_REPLACE_BY_OVERLAY
# Logging
LOGGING_LEVEL=debug
LOGGING_FORMAT=json
# Telemetry
TELEMETRY_SERVICE_NAME=liverty-music-consumer
# Goroutine Leak Detection (Go 1.27 goroutineleak profile → backend_goroutine_leak_count
# gauge + "Backend Goroutine Leak" alert). Sampler + internal pprof listener on
# DEBUG_PORT (default 6060, bound to loopback, not exposed by any Service).
GOROUTINE_LEAK_DETECTION_ENABLED=true
# Database (Defaults)
DATABASE_NAME=liverty-music
DATABASE_HOST=postgres.osaka.psc.internal
DATABASE_PORT=5432
DATABASE_USER=TO_REPLACE_BY_OVERLAY
DATABASE_SSL_MODE=disable
DATABASE_SCHEMA=app
# Shutdown timeout must fit within: terminationGracePeriodSeconds(90) - preStop(5) - buffer(25) = 60s
SHUTDOWN_TIMEOUT=60s
# NATS
NATS_URL=TO_REPLACE_BY_OVERLAY
# GCP
GCP_PROJECT_ID=TO_REPLACE_BY_OVERLAY
# OIDC (Zitadel domain for API calls)
OIDC_ISSUER_URL=TO_REPLACE_BY_OVERLAY
# Identity service listener for this workload. When set, verification emails
# and passkey recovery links go through it and the two Zitadel keys below are
# not read (they are unmounted once the backend drops the direct client).
IDENTITY_SERVICE_URL=http://identity:9100
# Zitadel Machine Key (Email Verification)
ZITADEL_MACHINE_KEY_FOR_BACKEND_APP_PATH=/secrets/zitadel/zitadel-machine-key-for-backend-app.json
# Zitadel Machine Key (passkey recovery links): the fan-passkey-recovery machine
# user (ORG_OWNER on the product org), mounted from event-consumer-secrets. Set on
# event-consumer only, never on fan-api.
ZITADEL_MACHINE_KEY_FOR_FAN_PASSKEY_RECOVERY_PATH=/secrets/zitadel-fan-passkey-recovery/zitadel-machine-key-for-fan-passkey-recovery.json
# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=TO_REPLACE_BY_OVERLAY
VAPID_CONTACT=mailto:pepperoni9@gmail.com
# Product Analytics (PostHog) — POSTHOG_PROJECT_API_KEY comes from
# backend-secrets via envFrom (synced from GSM by ExternalSecret).
POSTHOG_API_HOST=https://eu.i.posthog.com

# Downgrade the protobuf global-registry extension-number collision (ext 50001 on
# google.protobuf.MethodOptions) between zitadel-go and the Pocket Sign gen protos
# from a startup PANIC to ignore. Not `warn`: it prints plain text to stderr,
# which GKE ingests as severity=ERROR and trips the ERROR-log alerts on every
# start. Unavoidable third-party dup; protobuf-go documented resolution
# (protobuf.dev/reference/go/faq#namespace-conflict).
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore
