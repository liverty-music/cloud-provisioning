# Environment
ENVIRONMENT=TO_REPLACE_BY_OVERLAY
# Logging
LOGGING_LEVEL=debug
LOGGING_FORMAT=json
# Telemetry
TELEMETRY_SERVICE_NAME=liverty-music-sales-phase-discovery
# GCP (Defaults)
GCP_PROJECT_ID=TO_REPLACE_BY_OVERLAY
GCP_LOCATION=global
# Published-sale searcher: one grounded gemini-4-hydrogen call that returns
# JSON, thinking=low. Evaluated on 2026-11-21 (backend
# docs/gemini-concert-searcher-tuning.md §10.9): 40 of 42 fixture sales found
# with no wrong values, at $0.067 per call against $0.345 for gemini-3.8-flash
# at the 2027-01-01 price.
GCP_GEMINI_SEARCH_MODEL_EXTRACT=gemini-4-hydrogen
GCP_GEMINI_SEARCH_THINKING_EXTRACT=low
# Database (Defaults)
DATABASE_NAME=liverty-music
DATABASE_HOST=postgres.osaka.psc.internal
DATABASE_PORT=5432
DATABASE_USER=TO_REPLACE_BY_OVERLAY
# Must be 'disable' because the Cloud SQL Connector handles internal encryption.
# Setting it to 'require' causes a double-encryption conflict/TLS refusal.
DATABASE_SSL_MODE=disable
DATABASE_SCHEMA=app

# Shutdown timeout must fit within: terminationGracePeriodSeconds(120) - buffer(30) = 90s
SHUTDOWN_TIMEOUT=90s
# NATS — loaded by the job's config but not used: the job records
# TICKET_SALE.discovered in the outbox, and the workflow worker's forwarder
# delivers it to JetStream.
NATS_URL=TO_REPLACE_BY_OVERLAY

# Product Analytics (PostHog): Gemini call and search outcome events. The
# project key is set per overlay; an empty key turns reporting off.
POSTHOG_API_HOST=https://eu.i.posthog.com

# Downgrade the protobuf global-registry extension-number collision (ext 50001 on
# google.protobuf.MethodOptions) between zitadel-go and the Pocket Sign gen protos
# from a startup PANIC to ignore. Not `warn`: it prints plain text to stderr,
# which GKE ingests as severity=ERROR and trips the ERROR-log alerts on every
# start. Unavoidable third-party dup; protobuf-go documented resolution
# (protobuf.dev/reference/go/faq#namespace-conflict).
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=ignore
