# Environment
ENVIRONMENT=TO_REPLACE_BY_OVERLAY
# Logging
LOGGING_LEVEL=debug
LOGGING_FORMAT=json
# Telemetry
TELEMETRY_SERVICE_NAME=liverty-music-media-consumer
# GCP
GCP_PROJECT_ID=TO_REPLACE_BY_OVERLAY
# Database — the media-consumer performs the series_media cut-over (FindMediaByID
# + UPDATE), so it needs DB access. It connects as its OWN IAM DB user via the
# in-process Cloud SQL Go connector (Workload Identity IAM auth). Overlays set
# DATABASE_USER + the prod-specific host / instance-connection-name.
DATABASE_NAME=liverty-music
DATABASE_HOST=postgres.osaka.psc.internal
DATABASE_PORT=5432
DATABASE_USER=TO_REPLACE_BY_OVERLAY
DATABASE_SSL_MODE=disable
DATABASE_SCHEMA=app
# NATS
NATS_URL=TO_REPLACE_BY_OVERLAY
# Organizer media buckets. The consumer reads the uploaded original from the
# PRIVATE originals bucket ({org}/{mediaId}) and writes processed variants to the
# served bucket (cdn/{org}/{mediaId}/{variant}.webp). Names match the Pulumi
# stack outputs (organizer-media.ts). Overlays set the env-specific values.
ORGANIZER_MEDIA_INTERNAL_BUCKET=TO_REPLACE_BY_OVERLAY
ORGANIZER_MEDIA_BUCKET=TO_REPLACE_BY_OVERLAY
# Shutdown timeout must fit within: terminationGracePeriodSeconds(90) - buffer(30) = 60s
SHUTDOWN_TIMEOUT=60s
